{
    "scan_directories": [
        {
            "path": "M:/<媒体库>",
            "recursive": true,
            "enabled": true
        }
    ],
    "auto_scan_on_startup": false,
    "supported_formats": [
        ".mp4",
        ".avi",
        ".mkv",
        ".mov",
        ".wmv",
        ".flv",
        ".webm",
        ".m4v"
    ],
    "default_tags": [],
    "default_priority": 0,
    "ports": {
        "web": 8080,
        "main_app": 8080,
        "admin_app": 8081,
        "thumbnail": 5001
    },
    "host": "0.0.0.0",
    "auto_start": true,
    "scan_interval_minutes": 60,
    "tls": {
        "enabled": false,
        "cert_file": "",
        "key_file": "",
        "port": 8443,
        "disable_http": false
    },
    "test": "value",
    "scan_directory": "/path/to/scan",
    "video_formats": [
        "mp4",
        "mkv",
        "avi"
    ],
    "library_watch_enabled": true
}