# Dbox 2.0 Git 忽略规则

# ============================================
# 运行时数据（data/ 目录）
# ============================================
*.db
*.db-journal
data/
data/databases/
data/libraries/
data/logs/
data/thumbnails/
data/uploads/
libraries/

# ============================================
# 用户运行时配置（已从项目分离到系统数据区，不纳入 git）
# 说明：web 配置 / 缩略图配置等运行时配置现由代码在首次启动时
# 自动生成到系统数据区（%LOCALAPPDATA%/Dbox 或 ~/.local/share/Dbox），
# 不再存放于项目目录，避免个人路径污染仓库、被他人拉取后不可用。
# 如仍需在仓库保留一份示例模板，请放到 configs/ 下并以 .example 结尾。
# ============================================
configs/web/config.json

# ============================================
# 日志文件
# ============================================
*.log
logs/

# ============================================
# Python 缓存
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ============================================
# 虚拟环境
# ============================================
venv/
ENV/
env/

# ============================================
# IDE 和编辑器
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================
# 操作系统文件
# ============================================
.DS_Store
Thumbs.db

# ============================================
# 环境变量和敏感信息
# ============================================
.env
.env.local
cookies.txt

# ============================================
# 前端构建产物和依赖
# ============================================
src/webui/dist/
src/webui/node_modules/
src/webui/.vite/
static/dist/
src/static/dist/

# ============================================
# 上传文件和缓存
# ============================================
uploads/
static/thumbnails/
dev_runtime/

# ============================================
# 旧目录（迁移后清理）
# ============================================
dbox-src/
msa-web/
msa-thumb/
frontend/
libs/
instance/

# ============================================
# 测试和覆盖率报告
# ============================================
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
test-results/
playwright-report/

# ============================================
# 临时文件
# ============================================
*.tmp
*.temp
*.bak
*.swp
*_out.txt
e2e_out.txt

# ============================================
# 归档目录（废弃文件）
# ============================================
_archived/

# ============================================
# WorkBuddy 相关（用户要求忽略）
# ============================================
.workbuddy/
.playwright-cli/
.codebuddy/

# ============================================
# 测试文件和临时脚本
# ============================================
# 根目录/其他位置的临时测试脚本不纳入 git（按规则：临时脚本不提交）。
# tests/ 下的正式测试套件需纳入版本控制并由 CI 执行，故显式放行。
test_*.py
!tests/test_*.py
check_*.py
run_check.bat
scripts/migrate_*.py
scripts/fix_*.py
scripts/verify_*.py
scripts/init_*.py
scripts/demo_*.py
scripts/export_*.py
scripts/backup_*.py
scripts/restore_*.py
scripts/clean_*.py

# ============================================
# 用户自定义外部脚本（仅本地运行，不纳入 git）
# 框架内置示例 demo_download 仍需纳管，故显式放行；
# 其余 extensions/scripts/<任意id>/ 目录均忽略。
# 新增内置脚本时，需在此追加对应的 !extensions/scripts/<id>/ 放行。
# ============================================
extensions/scripts/*/
!extensions/scripts/demo_download/
!extensions/scripts/x_downloader/
!extensions/scripts/feedback_ai/
!extensions/scripts/ai_chat/

# ai_assistant 是独立仓库（外部扩展，已抽离为独立 git 仓库），
# 主仓库不跟踪其内容，仅保留本地目录供运行时加载。
extensions/ai_assistant/
